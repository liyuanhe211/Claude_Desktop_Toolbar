# Standard .gitignore (generated by Initialize_Project_Gitignore.py)

# Claude's exploratory scripts and temporary data (including archived user-provided screenshots)
_Claude_tmp/

# Sensitive / private files, second line of defense (case-insensitive, any position)
*[Ss][Ee][Cc][Rr][Ee][Tt]*
*[Pp][Rr][Ii][Vv][Aa][Tt][Ee]*

# Broad exclusions: temporary / obsolete / to-do (any case, any position; force-add a wrongly matched file with git add -f)
*[Tt][Ee][Mm][Pp]*
# Names containing "Template" are not temporary files: re-include them (must stay after the Temp pattern; cannot rescue a path whose parent directory is itself excluded)
!*[Tt][Ee][Mm][Pp][Ll][Aa][Tt][Ee]*
*[Oo][Bb][Ss][Oo][Ll][Ee][Tt][Ee]*
*[Tt][Oo][Dd][Oo]*

# Test files: not reviewed as strictly as production code and their fixtures may leak private data, so excluded by default.
# Case-insensitive word match on test / tests / tested (word boundaries: name start/end, "_", "."), so names like
# "latest" or "contest" are NOT caught; force-add a wrongly matched file with git add -f.
[Tt][Ee][Ss][Tt]/
[Tt][Ee][Ss][Tt][Ss]/
[Uu][Nn][Ii][Tt]_[Tt][Ee][Ss][Tt]/
[Uu][Nn][Ii][Tt]_[Tt][Ee][Ss][Tt][Ss]/
_[Tt][Ee][Ss][Tt][Ss]*/
[Tt][Ee][Ss][Tt]_*
[Tt][Ee][Ss][Tt][Ss]_*
[Tt][Ee][Ss][Tt][Ee][Dd]_*
*_[Tt][Ee][Ss][Tt].*
*_[Tt][Ee][Ss][Tt][Ss].*
*_[Tt][Ee][Ss][Tt][Ee][Dd].*
*_[Tt][Ee][Ss][Tt]_*
*_[Tt][Ee][Ss][Tt][Ss]_*
*_[Tt][Ee][Ss][Tt][Ee][Dd]_*

# This plugin publishes its tests: their fixtures hold no private data (must stay after the test patterns above)
# deviation: [Tt][Ee][Ss][Tt][Ss]/ the published plugin ships its claude plugin test suites; fixtures use neutral folder names
![Tt]ests/

# Local Claude collaboration instructions and project settings
CLAUDE.md
.claude/

# Local only: the personal development log (CHANGELOG.md is the public history) and the separate
# desktop-app style patch, which is not part of the plugin
Development_Notes.md
Desktop_Style_Patch/

# Codex counterparts of the Claude entries above (the repo-level .agents/ plugin-marketplace directory is shared content and stays tracked)
AGENTS.md
AGENTS.override.md
.codex/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Lint and test caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node
node_modules/

# Type declarations the Claude Code engine lays beside a mod at every load
.claude-plugin/types/

# Environment variable files (keep API keys and the like out of the repository; .env.example is a key-free sample and is kept)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Office lock files and backup / temporary suffixes
~$*
*.bak
*.tmp
*.swp
*~

# Editors
.idea/
.vscode/
.history/

# System files
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
ehthumbs.db
